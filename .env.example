# REPLACE THE VALUES BELOW WITH YOUR ACTUAL KEYS IF NOT AUTOMATICALLY SET

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummykey.updateyourkkey.here

# API Keys
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Analytics & Ads
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-google-analytics-id-here
NEXT_PUBLIC_ADSENSE_ID=your-adsense-id-here

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:4028
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001

# --- Backend (Node.js) ---
NODE_ENV=development
BACKEND_PORT=5001
FRONTEND_ORIGIN=http://localhost:4028

EXECUTION_TIMEOUT_MS=7000
EXECUTION_MIN_TIMEOUT_MS=500
EXECUTION_MAX_TIMEOUT_MS=20000
EXECUTION_MAX_CODE_SIZE=200000
EXECUTION_CPU_LIMIT=0.5
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_PIDS_LIMIT=64
EXECUTION_QUEUE_CONCURRENCY=2
EXECUTION_TMP_ROOT=/tmp/codepilot-exec
